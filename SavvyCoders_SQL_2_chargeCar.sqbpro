><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT *
FROM factCharge AS fc
LEFT JOIN dimFacility AS df on
fc.facilityID = df.FacilityKey
ORDER BY df.typeFacility</sql><sql name="SQL 2*">SELECT DISTINCT b.userId, c.carMake, c.carModel, c.priceEuro * 1.09 AS priceUSD
FROM factCharge a
INNER JOIN dimUser b
ON a.userID = b.userId
LEFT JOIN dimCar c
ON b.carID = c.carID
</sql><sql name="SQL 3*">SELECT SUBSTR('SQLITE SUBSTR', 7, 7) AS 'newString';
</sql><sql name="SQL 4*">SELECT SUBSTR('SQLITE SUBSTR', 3,5) AS 'newString';
</sql><sql name="SQL 5*">SELECT SUBSTR(dayOfWeek, 1, 3) AS 'String'
from dimDay;</sql><sql name="SQL 6*">SELECT appPlatform, TRIM(appPlatform, 'i')
from dimUser
WHERE appPlatform = 'ios'</sql><sql name="SQL 7*">SELECT '    SQLite   ' , TRIM('    SQLite   ') as trimmedString;

</sql><sql name="SQL 8*">SELECT LTRIM('!!!HI', '!') as ltrimmedHI, RTRIM('HI!!!', '!') as rtrimmedHI;</sql><sql name="SQL 9*">SELECT typefacility, LENGTH(typefacility) as 'lenFacility'
FROM dimFacility</sql><sql name="SQL 10*">SELECT Replace('I miss my dog', 'dog', 'cat') as replaceString;
</sql><sql name="SQL 11*">SELECT LOWER('SqL RoCks') as lowerString, UPPER('SqL RoCks') as upperString; </sql><sql name="SQL 12*">SELECT dayAbbr || 'day'
FROM dimDay
WHERE dayAbbr = 'Mon';</sql><sql name="SQL 13*">SELECT appPlatform FROM dimUser WHERE appPlatform = 'ios';

UPDATE dimUser SET appPlatform = 'Apple' WHERE appPlatform = 'ios';</sql><sql name="SQL 14*">SELECT distanceHome FROM dimUser WHERE distanceHome IS NULL;

UPDATE dimUser SET distanceHome = 0 WHERE distanceHome IS NULL;</sql><sql name="SQL 15*">ALTER TABLE dimUser
ADD COLUMN annualIncome;

DROP COLUMN WILL DELETE A COLUMN</sql><sql name="SQL 16*">ALTER TABLE dimUser
RENAME distanceHome to distanceToWork;
</sql><current_tab id="15"/></tab_sql></sqlb_project>
